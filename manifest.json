{
  "manifest_version": 3,
  "name": "羊魔 · 视频收藏",
  "version": "2.4.5",
  "minimum_chrome_version": "116",
  "description": "简洁的网页视频收藏助手。下载直链、HLS 点播、YouTube 和哔哩哔哩投稿视频；支持当前分P、音视频合并和实时分片并发。",
  "icons": {
    "16": "icons/yangmo-mascot.png",
    "48": "icons/yangmo-mascot.png",
    "128": "icons/yangmo-mascot.png"
  },
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "nativeMessaging"
  ],
  "optional_permissions": ["cookies"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "羊魔 · 视频收藏",
    "default_icon": {
      "16": "icons/yangmo-mascot.png",
      "48": "icons/yangmo-mascot.png",
      "128": "icons/yangmo-mascot.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
