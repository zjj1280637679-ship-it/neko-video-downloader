{
  "manifest_version": 3,
  "name": "羊魔 · 视频收藏",
  "version": "2.2.1",
  "minimum_chrome_version": "116",
  "description": "简洁的网页视频收藏助手。识别当前线路，下载直链与 AES-128 HLS 点播；解释来源、并发策略和保存结果。",
  "icons": {
    "16": "icons/yangmo-mascot.png",
    "48": "icons/yangmo-mascot.png",
    "128": "icons/yangmo-mascot.png"
  },
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "羊魔 · 视频收藏",
    "default_icon": {
      "16": "icons/yangmo-mascot.png",
      "48": "icons/yangmo-mascot.png",
      "128": "icons/yangmo-mascot.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
